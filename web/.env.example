# Copy to web/.env.local for local runs; set the same names in the Vercel project for the web app.
# The API (backend) base URL, without a trailing slash.
VITE_API_URL=http://localhost:8000
# Supabase project (Settings -> API): URL and the publishable/anon key (safe for browsers).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Must match the API's AAYRA_STUDENT_LOGIN_DOMAIN (students without email sign in with a username).
VITE_STUDENT_LOGIN_DOMAIN=students.aayra.invalid
# Local development only: sign in as any seeded user without Supabase (needs the API in local mode).
VITE_DEV_LOGIN=false
