# Copy to backend/.env for local runs. Never commit real values.
AAYRA_DATABASE_URL=postgresql+asyncpg://postgres@/aayra_dev?host=/tmp&port=54322
AAYRA_JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes
AAYRA_ENVIRONMENT=local
# Platform-operator key for POST /v1/schools (school bootstrap). Leave unset to disable.
AAYRA_BOOTSTRAP_KEY=

AAYRA_IDENTITY_PROVIDER=stub
# stub (local/tests) | supabase (real logins; needs AAYRA_SUPABASE_URL + AAYRA_SUPABASE_SERVICE_ROLE_KEY)

# --- Storage: stub (local/tests) | supabase
AAYRA_STORAGE_PROVIDER=stub
AAYRA_STORAGE_BUCKET=lesson-content
AAYRA_SUPABASE_URL=
# Server-side only. Never ship to a client.
AAYRA_SUPABASE_SERVICE_ROLE_KEY=

# --- AI models: stub (local/tests) | anthropic
AAYRA_AI_PROVIDER=stub
AAYRA_ANTHROPIC_API_KEY=
# Required when AAYRA_AI_PROVIDER=anthropic: the exact Claude model id your account can use.
AAYRA_AI_MODEL=
AAYRA_AI_TIMEOUT_SECONDS=60

# --- Speech-to-text for VIDEO/AUDIO: stub (local/tests) | openai. Needs ffmpeg on the server for big/video files.
AAYRA_TRANSCRIPTION_PROVIDER=stub
AAYRA_OPENAI_API_KEY=
# Required when AAYRA_TRANSCRIPTION_PROVIDER=openai (e.g. whisper-1 for timestamps).
AAYRA_TRANSCRIPTION_MODEL=
AAYRA_TRANSCRIPTION_TIMEOUT_SECONDS=300
AAYRA_MAX_MEDIA_SECONDS=14400

# --- Optional: YouTube Data API key (video title/duration/existence only)
AAYRA_YOUTUBE_API_KEY=

# --- Deployment (see DEPLOY.md)
# Browser origins allowed to call the API (comma separated), e.g. https://aayra-web.vercel.app
AAYRA_CORS_ORIGINS=
# Shared secret for POST /internal/worker/run (GitHub Actions every 5 min). Unset = disabled.
AAYRA_WORKER_SECRET=
# Where invite emails send people (the web app URL)
AAYRA_WEB_APP_URL=
# Login domain for students without email (must match the web app's VITE_STUDENT_LOGIN_DOMAIN)
AAYRA_STUDENT_LOGIN_DOMAIN=students.aayra.invalid
# Set automatically on Vercel; force true when using Supabase's transaction pooler elsewhere
# AAYRA_DB_SERVERLESS=true
